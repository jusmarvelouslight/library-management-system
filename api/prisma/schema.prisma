
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(PATRON)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Genre {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  books       Book[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Book {
  id            String   @id @default(uuid())
  title         String
  author        String
  isbn          String?  @unique
  description   String?
  publishedYear Int?
  genreId       String
  genre         Genre    @relation(fields: [genreId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([genreId])
  @@index([title])
}
